{
	"$schema": "https://dsh-blue.dev/schema/blue.plugin.v1.schema.json",
	"schemaVersion": 1,
	"id": "dsh-tokenledger",
	"entry": ".",
	"api": "^1.0.0-beta.1",
	"compatibility": {
		"blue": ">=0.1.2-alpha.1 <0.1.2",
		"harness": "0.1.2-alpha.2",
		"node": "^22.19.0 || >=24.0.0"
	},
	"capabilities": {
		"required": [
			{
				"name": "commands",
				"version": "^1.0.0",
				"resources": { "names": ["tokenledger"] }
			},
			{ "name": "overlays", "version": "^1.0.0" }
		],
		"optional": [
			{ "name": "notifications.publish", "version": "^1.0.0" },
			{
				"name": "session.read",
				"version": "^1.0.0",
				"resources": { "fields": ["identity", "status", "model"] }
			}
		]
	}
}
